# WardenAI environment template
# Never commit real secrets. Set production values in Vercel Environment Variables.

APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# REQUIRED IN PRODUCTION: 32+ characters.
JWT_SECRET="replace-with-32-plus-character-random-secret"

# Local seed users. Production deploys fail closed if these are not explicitly set.
DEMO_ADMIN_PASSWORD="ChangeMe-LocalOnly-2026!"
DEMO_DEV_PASSWORD="ChangeMe-DevOnly-2026!"

# Google login stays disabled until a verified OAuth flow is configured.
ENABLE_GOOGLE_LOGIN="false"

# v1 credential-isolated Gmail gateway.
# Use a valid server-side OAuth access token only for controlled testing.
# For long-lived production use, replace this with stored OAuth refresh credentials.
GMAIL_ACCESS_TOKEN=""

# Optional providers / future gateways.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO="price_pro_monthly"
STRIPE_PRICE_BUSINESS="price_business_monthly"
GEMINI_API_KEY=""
